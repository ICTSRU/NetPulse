/**
 * نبض الشبكة — SRU NetPulse · Brand images for e-mails (v1.7)
 * Embedded as inline (cid:) images so they display in Outlook/Gmail without external hosting.
 */
const BRAND_IMG = {
  lockupWhite: '',
  itoc: ''
};

function brandBlobs_() {
  return {
    nplogo: Utilities.newBlob(Utilities.base64Decode(BRAND_IMG.lockupWhite), 'image/png', 'netpulse.png'),
    itoclogo: Utilities.newBlob(Utilities.base64Decode(BRAND_IMG.itoc), 'image/png', 'itoc.png')
  };
}
